# Producción (por ejemplo, para el contenedor: docker run --env-file .env.production ...).
# Copialo como .env.production y poné la URI real. Ese archivo no se sube al repo ni entra en la imagen.

# Obligatorias
NODE_ENV=production
# Desde Docker, para usar el MongoDB de tu máquina: mongodb://host.docker.internal:27017/shipnow
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/shipnow

# Opcionales
PORT=8080
LOG_LEVEL=info
